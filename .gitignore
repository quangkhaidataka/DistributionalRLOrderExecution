# Files intentionally excluded from the repository

# Archived / unused code (kept locally, not pushed)
unnecessary_files/

# Large data files (regenerate via loaders / WRDS)
data/processed/
data/raw/

# Generated experiment outputs and model checkpoints
results/
results_regime_50000_10000/
*.pt

# Python
__pycache__/
*.py[cod]

# Run logs (byproducts; e.g. batch_a.log). Keep locally, don't track.
*.log

# OS / editor
.DS_Store

# --- order_robust_check/ (self-contained order-size robustness appendix) ---
# This folder IS published: its results (tables + per-cell metrics) and its
# checkpoints are part of the deliverable, so they override the blanket
# `results/` and `*.pt` rules above.
!order_robust_check/results/
!order_robust_check/checkpoints/**/*.pt
# ...but never its copy of the AAPL TAQ bars: NYSE TAQ via WRDS is licensed
# data. Regenerate with the loaders (see order_robust_check/run_order_robust.py).
order_robust_check/data/
